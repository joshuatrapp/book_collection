<%= render(partial: 'flash') %>
<%= link_to('New', new_book_path) %>
<h1>Books</h1>
<table>
    <tr>
        <th>Title</th>
        <th>Actions</th>
    </tr>
    <% @books.each do |book| %>
        <tr>
            <td><%= book.title %></td>
            <td>
                <%= link_to('Show', book_path(book)) %>
                <%= link_to('Edit', edit_book_path(book)) %>
                <%= link_to('Delete', delete_book_path(book)) %>
            </td>
        </tr>
    <% end %>
</table>